# Copy to apps/web/.env.local and fill in.
# Only NEXT_PUBLIC_* vars may be read from browser code.

# --- Supabase (client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth ---
# Owner e-mail (must also exist in public.allowed_emails). The household is created on the
# owner's first sign-in; `pnpm db:invite <email>` adds the second person to that same one.
OWNER_EMAIL=
