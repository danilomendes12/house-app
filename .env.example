# Copy to apps/web/.env.local and fill in.
# Everything here is server-only: the browser never talks to Supabase directly, so there is
# no NEXT_PUBLIC_* var. All of it is read at runtime — the Docker image is not tied to any
# particular installation.

# --- Supabase ---
# Base URL of the API. Local: http://127.0.0.1:54321.
# Self-hosted: the internal address of the Caddy API block (http://caddy:8000).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth ---
# Owner e-mail (must also exist in public.allowed_emails). The household is created on the
# owner's first sign-in; `pnpm db:invite <email>` adds the second person to that same one.
OWNER_EMAIL=

# Optional, read only by the provisioning scripts: when unset, they generate a strong
# password and print it once. `pnpm db:password <email>` resets it later.
# OWNER_PASSWORD=
# MEMBER_PASSWORD=
