# Copy to apps/web/.env.local and fill in.
# Only NEXT_PUBLIC_* vars may be read from browser code.

# --- Supabase (client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth ---
# Single owner e-mail allowed to sign in (must also exist in public.allowed_emails).
OWNER_EMAIL=

# --- Pluggy (server-only, phase 3) ---
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# --- Cron (server-only, phase 3) ---
# openssl rand -hex 32
CRON_SECRET=
