# The only env file in this repository. The real deploy/.env is written on the first
# `pnpm dev` by scripts/gen-secrets.mjs — this file is just the reference for what reads
# what. deploy/.env is a secret and never goes to git.
#
# Three consumers, and every variable below says which one it has: docker compose
# (substitution in docker-compose.yml and docker-compose.server.yml), `pnpm dev`, which
# passes the three SUPABASE_* values to the Next server it starts on the host, and the
# scripts in scripts/. The app itself reads only what `pnpm dev` or the container hands it
# — there is no NEXT_PUBLIC_* anywhere, and nothing here is compiled into the image.
#
# The server has its **own** copy of this file, generated on the VM by
# `scripts/gen-secrets.mjs --server` during `pnpm server init`. It is never copied up from
# here: production secrets must not be the ones that have been sitting on a laptop.

# Secrets and ports, nothing else. There is no OWNER_EMAIL here: who owns this
# installation is a fact of the database. `pnpm db:owner <email>` writes it once — that is
# the one thing a closed household cannot decide for itself — and `db:invite` reads the
# household from there.

# Where the API answers *from the host* — the loopback port Caddy publishes. Inside the
# compose network the same API is http://caddy:8000, which is what the web container uses.
# Read by: the app (via `pnpm dev`) and the provisioning scripts.
SUPABASE_URL=http://127.0.0.1:8000

# --- generated by scripts/gen-secrets.mjs: never fill these in by hand ---
# The two keys are JWTs signed with JWT_SECRET. If the three ever drift apart, the only
# symptom is a bare 401. Never reuse the Supabase CLI's local keys: they are public.
# Read by: docker compose, the app, the scripts.
POSTGRES_PASSWORD=
JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- only on the server (written by `gen-secrets.mjs --server`) ---
# Marks this checkout as the production one. Read by: the scripts — it is what makes them
# layer docker-compose.server.yml, so `pnpm stack up`, `logs`, `down` and the backup do the
# server thing without a flag to remember.
# DEPLOY_TARGET=server
#
# The public name of the app. Read by: docker compose (the server override hands it to
# Caddy, which issues and renews the certificate for exactly this) and, on your machine,
# by `pnpm server` to seed the VM's file and to check the site after a deploy. The app
# never reads it.
# DOMAIN=tinocot.com

# --- only on your machine: how to reach the server (read by scripts/server.mjs) ---
# Nothing here goes to the VM, and docker compose ignores all of it. Fill in by hand after
# creating the instance — docs/DEPLOY.md walks through the Oracle console part.
# DEPLOY_HOST=                                        # IP público (ou o próprio domínio)
# DEPLOY_USER=ubuntu                                  # default: ubuntu
# DEPLOY_PATH=/opt/financas                           # default: /opt/financas
# DEPLOY_REPO=git@github.com:voce/my-financial-app.git  # só o `pnpm server init` usa
# DEPLOY_BRANCH=main                                  # default: main
# DEPLOY_SSH_KEY=~/.ssh/oracle_financas               # só se não for a chave padrão

# --- optional ---
# Ports, when something on your machine already holds the default.
# WEB_PORT=3000
# SUPABASE_API_PORT=8000
# POSTGRES_PORT=5432
# STUDIO_PORT=54323

# Where `pnpm db:dump` writes and `pnpm db:restore --latest` looks. Read by: the scripts.
# Default: deploy/backups/, the same relative path on both machines.
# BACKUP_DIR=

# Read only by the provisioning scripts, and only when set: without them a strong password
# is generated and printed once. `pnpm db:password <email>` resets it later.
# OWNER_PASSWORD=
# MEMBER_PASSWORD=

# Only needed if this installation ever holds more than one household: `db:invite` refuses
# to guess which one, rather than joining whichever exists (SPEC §12).
# HOUSEHOLD_ID=
