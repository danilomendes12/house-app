# Deploy configuration. The real file is written by `node ../scripts/gen-secrets.mjs`,
# which fills in the four generated values below — do not invent them by hand, and never
# reuse the Supabase CLI's local keys: they are public.
#
# This file is only a reference for what the compose stack reads. deploy/.env is a secret.

# --- your installation ---
# Domain already pointing at this VM (an A record). Caddy issues the certificate for it.
DOMAIN=financas.exemplo.com
# Where Let's Encrypt sends expiry warnings.
TLS_EMAIL=voce@exemplo.com
# Owner of the household; `pnpm db:owner` allowlists it and creates the user.
OWNER_EMAIL=voce@exemplo.com

# Loopback port for Postgres on the VM, for `supabase db push` and restores over an SSH
# tunnel. Optional; defaults to 5432.
# POSTGRES_PORT=5432

# --- generated by scripts/gen-secrets.mjs ---
# Password of every Postgres role (postgres, authenticator, supabase_auth_admin).
POSTGRES_PASSWORD=
# Signs the session JWTs. The two keys below are derived from it: change it and they must
# be regenerated together, or the only symptom is a bare 401.
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
