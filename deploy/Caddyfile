# Two blocks, two audiences.
#
# :8000 is Supabase's API, private on every installation. `supabase-js` is built around one
# base URL and calls /auth/v1/token and /rest/v1/<table> under it — but those are two
# different containers. This joins them, and it is what replaces Kong: the API is not
# public, the `anon` role holds no grant (the migrations revoke everything) and PostgREST
# validates the JWT by itself. Both services serve at the root, so the prefix has to be
# *removed* — `handle_path` does that, `handle` would not.
#
# {$DOMAIN} is the app, and the only thing this project exposes to the internet. Caddy gets
# and renews the certificate itself over ACME on 80/443, which is the whole reason it is
# here rather than a plain proxy — and the reason the PWA installs at all: no HTTPS, no
# secure context, no service worker, no icon on the iPhone home screen (SPEC §8).
#
# Locally DOMAIN is unset and this falls back to `localhost`, for which Caddy uses its own
# internal CA and talks to no one. Ports 80/443 are not published there either
# (docker-compose.server.yml adds them), so the block simply sits idle.

:8000 {
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}

	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}

	handle {
		respond "not found" 404
	}
}

{$DOMAIN:localhost} {
	# The app lives under /financial (SPEC §12), and `handle` is deliberate: the block above
	# uses `handle_path` because GoTrue and PostgREST serve at the root and the prefix has to
	# go away — here it is the opposite. Next is built with basePath: '/financial', so it
	# emits and expects that prefix; stripping it would 404 every asset.
	#
	# Nothing here routes to `auth` or `rest`: the browser never talks to Supabase in this
	# project — every read and write is a Server Component, Server Action or Route Handler
	# (SPEC §5.4) — so publishing the API would open a door that no client uses.
	handle /financial* {
		reverse_proxy web:3000
	}

	# The root is not the app's. A redirect is friendlier than a 404 for the person who types
	# the bare domain, and it keeps this a single door.
	handle {
		redir https://{host}/financial{uri} 308
	}
}
