# Gives Supabase's API a single origin, on :8000.
#
# `supabase-js` is built around one base URL and calls /auth/v1/token and /rest/v1/<table>
# under it — but those are two different containers. This joins them, and it is what
# replaces Kong: the API is not public, the `anon` role holds no grant (the migrations
# revoke everything) and PostgREST validates the JWT by itself.
#
# Both services serve at the root, so the prefix has to be *removed* — `handle_path` does
# that, `handle` would not.
#
# Not here yet: the public HTTPS block that fronts the app on a server. It comes back when
# the hosting is chosen (SPEC §11, Q5); until then the app is served by `next dev` on the
# host, and there is no certificate to issue.
:8000 {
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}

	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}

	handle {
		respond "not found" 404
	}
}
